# Preserve the FreeSurfer development build used by app version 1.7.
FROM brainlife/freesurfer@sha256:c6711f2499978bf26045b5144cbdac6187330e44259def15da5c8f147e1eb9d6

# Install only GNU time; fs_time requires the absolute /usr/bin/time path.
ADD https://vault.centos.org/7.9.2009/os/x86_64/Packages/time-1.7-45.el7.x86_64.rpm /tmp/time.rpm
RUN echo "fdb381e12e4fa1d4e4b7680b2ca90813b5048c42a0a41d7f1270b5a5d3a5358f  /tmp/time.rpm" | sha256sum -c - \
    && rpm --checksig /tmp/time.rpm \
    && rpm -ivh /tmp/time.rpm \
    && rm /tmp/time.rpm \
    && /usr/bin/time --version
